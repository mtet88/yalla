    "Por ahora tus ideas se guardan en este dispositivo. El login con Google/email y la migracion a Supabase vendran despues de validar el flujo local." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For now, your ideas are saved on this device. Google/email login and Supabase migration will come after validating the local flow."
          }
        },
        "es" : {
          "stringUnit" : {
